/* Modern Flat Theme for Zennity Engine Logic Graph */

QWidget#LogicGraphEditor {
    background-color: #0b0d14;
    color: #f1f5f9;
    font-family: "Segoe UI", sans-serif;
}

QSplitter::handle {
    background-color: #1e2430;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Header & Breadcrumb Toolbar */
QWidget#LogicHeader {
    background-color: #0d0f17;
    border-bottom: 1px solid #1c2230;
}

QLabel#Breadcrumb {
    color: #94a3b8;
    font-weight: 500;
    font-size: 12px;
}

QLabel#BreadcrumbBold {
    color: #f8fafc;
    font-weight: bold;
    font-size: 12px;
}

/* Navigation Rail (Left Panel) */
QFrame#LogicNavRail {
    background-color: #0f121a;
    border-right: 1px solid #1e2430;
}

QToolButton#RailButton {
    background: transparent;
    color: #94a3b8;
    border: none;
    border-left: 3px solid transparent;
    font-size: 10px;
    font-weight: bold;
}

QToolButton#RailButton:hover {
    color: #f1f5f9;
    background-color: #1a202c;
}

QToolButton#RailButton:checked {
    color: #3b82f6;
    background-color: #1c2436;
    border-left: 3px solid #3b82f6;
}

/* Library Panel & Node Palette */
QFrame#LogicPalettePanel {
    background-color: #141720;
    border-right: 1px solid #1e2430;
}

QLineEdit#NodeSearch {
    background-color: #1a1e2a;
    color: #f1f5f9;
    border: 1px solid #282f42;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

QLineEdit#NodeSearch:focus {
    border: 1px solid #3b82f6;
}

QListWidget#LogicNodePalette {
    background-color: #141720;
    border: none;
    outline: none;
}

/* Tab Widgets */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background: #141824;
    color: #94a3b8;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: bold;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #1e2536;
    color: #f8fafc;
    border-bottom: 2px solid #38bdf8;
}

/* Properties & Help Panel */
QFrame#LogicPropertiesPanel {
    background-color: #141720;
    border-left: 1px solid #1e2430;
}

QTreeWidget#LogicPropertyTree {
    background-color: #0f121a;
    color: #cbd5e1;
    border: 1px solid #1e2430;
    border-radius: 6px;
}

/* Footer Panel */
QFrame#LogicFooterPanel {
    background-color: #0f121a;
    border-top: 1px solid #1e2430;
}
