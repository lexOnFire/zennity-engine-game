/* Zennity Editor - clean studio theme */

QWidget {
    background: #181817;
    color: #e8e3d8;
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    font-size: 12px;
    selection-background-color: #3b6f68;
    selection-color: #f7f2e8;
}

QMainWindow#ZennityMainWindow {
    background: #111110;
}

QMenuBar {
    background: #111110;
    border: none;
}

QToolBar#CommandBar {
    background: #111110;
    border: none;
    border-bottom: 1px solid #292824;
    padding: 0;
    spacing: 0;
}

QWidget#CommandBarShell {
    background: #111110;
}

QLabel#BrandLabel {
    background: transparent;
    color: #f7f2e8;
    font-size: 17px;
    font-weight: 800;
    padding-right: 8px;
    letter-spacing: 0.5px;
}

QLabel#SceneLabel {
    background: #181817;
    border: 1px solid #292824;
    border-radius: 6px;
    color: #aaa397;
    font-size: 12px;
    padding: 5px 10px;
}

QFrame#CommandSeparator {
    background: #34322d;
    border: none;
    margin-left: 4px;
    margin-right: 4px;
    max-width: 1px;
}

QPushButton#CommandButton,
QPushButton#PrimaryCommandButton,
QPushButton#PlayButton,
QPushButton#PauseButton,
QPushButton#StopButton,
QPushButton#ToolCommandButton,
QToolButton#MenuButton {
    background: #24231f;
    border: 1px solid #38362f;
    border-radius: 6px;
    color: #ded8cc;
    font-weight: 600;
    padding: 5px 12px;
}

QPushButton#CommandButton:hover,
QPushButton#PrimaryCommandButton:hover,
QPushButton#PlayButton:hover,
QPushButton#PauseButton:hover,
QPushButton#StopButton:hover,
QPushButton#ToolCommandButton:hover,
QToolButton#MenuButton:hover {
    background: #2d2b26;
    border-color: #6f6a5f;
    color: #f7f2e8;
}

QPushButton#CommandButton:pressed,
QPushButton#PrimaryCommandButton:pressed,
QPushButton#PlayButton:pressed,
QPushButton#PauseButton:pressed,
QPushButton#StopButton:pressed,
QPushButton#ToolCommandButton:pressed,
QToolButton#MenuButton:pressed {
    background: #3b6f68;
    border-color: #4e8a81;
    color: #f7f2e8;
}

QPushButton#CommandButton:checked,
QPushButton#ToolCommandButton:checked {
    background: #314844;
    border-color: #5aa195;
    color: #f7f2e8;
}

QPushButton#PrimaryCommandButton {
    background: #e8e3d8;
    border-color: #e8e3d8;
    color: #181817;
}

QPushButton#PrimaryCommandButton:hover {
    background: #f7f2e8;
    border-color: #f7f2e8;
    color: #111110;
}

QPushButton#PlayButton {
    background: #2c5f53;
    border-color: #3d7a6c;
    color: #f7f2e8;
}

QPushButton#PauseButton {
    background: #4f4329;
    border-color: #806a39;
    color: #f7f2e8;
}

QPushButton#StopButton {
    background: #5a2d2d;
    border-color: #8a4242;
    color: #f7f2e8;
}

QToolButton#MenuButton {
    padding-right: 18px;
}

QPushButton:disabled,
QToolButton:disabled {
    background: #1d1c19;
    border-color: #292824;
    color: #5f5a50;
}

QComboBox#ModeSwitch,
QComboBox {
    background: #24231f;
    border: 1px solid #38362f;
    border-radius: 6px;
    color: #ded8cc;
    padding: 5px 24px 5px 10px;
}

QComboBox:hover {
    border-color: #6f6a5f;
}

QComboBox::drop-down {
    width: 20px;
    border: none;
}

QComboBox QAbstractItemView {
    background: #201f1c;
    border: 1px solid #38362f;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #314844;
    selection-color: #f7f2e8;
}

QDockWidget {
    background: #151514;
    border: none;
    color: #cfc8bb;
    font-weight: 650;
    titlebar-close-icon: url(no_icon);
    titlebar-normal-icon: url(no_icon);
}

QDockWidget::title {
    background: #151514;
    border-top: 1px solid #292824;
    border-bottom: 1px solid #292824;
    padding: 8px 10px;
    text-align: left;
}

QDockWidget > QWidget {
    background: #181817;
}

QStatusBar {
    background: #111110;
    border-top: 1px solid #292824;
    color: #8f897d;
    min-height: 26px;
}

QStatusBar::item {
    border: none;
}

QLabel#StatusMetric {
    background: #181817;
    border: 1px solid #292824;
    border-radius: 5px;
    color: #aaa397;
    font-family: "Cascadia Code", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: 600;
    margin: 3px 4px;
    padding: 2px 10px;
}

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QDoubleSpinBox {
    background: #111110;
    border: 1px solid #34322d;
    border-radius: 6px;
    color: #eee8dc;
    padding: 6px 8px;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #5aa195;
}

QLineEdit::placeholder {
    color: #6d675e;
}

QTreeView,
QTreeWidget,
QListView,
QTableView {
    background: #151514;
    border: 1px solid #292824;
    border-radius: 6px;
    color: #ded8cc;
    outline: none;
    padding: 4px;
}

QTreeView::item,
QTreeWidget::item,
QListView::item {
    border-radius: 5px;
    padding: 6px;
    margin: 1px;
}

QTreeView::item:hover,
QTreeWidget::item:hover,
QListView::item:hover {
    background: #24231f;
}

QTreeView::item:selected,
QTreeWidget::item:selected,
QListView::item:selected {
    background: #314844;
    color: #f7f2e8;
}

QHeaderView::section {
    background: #181817;
    border: none;
    border-bottom: 1px solid #292824;
    color: #9f998c;
    padding: 6px;
}

QScrollArea,
QAbstractScrollArea {
    background: #181817;
    border: none;
}

QWidget#ViewportCanvas {
    background: #0f0f0e;
    border: 1px solid #34322d;
}

QSplitter::handle {
    background: #292824;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QTabWidget::pane {
    background: #181817;
    border: 1px solid #292824;
}

QTabBar::tab {
    background: #151514;
    border: none;
    border-bottom: 2px solid transparent;
    color: #8f897d;
    padding: 8px 14px;
}

QTabBar::tab:hover {
    color: #ded8cc;
}

QTabBar::tab:selected {
    color: #f7f2e8;
    border-bottom-color: #5aa195;
}

QGroupBox {
    background: #181817;
    border: 1px solid #292824;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 14px;
    color: #ded8cc;
    font-weight: 650;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #aaa397;
}

QPushButton {
    background: #24231f;
    border: 1px solid #38362f;
    border-radius: 6px;
    color: #ded8cc;
    padding: 6px 10px;
    font-weight: 600;
}

QPushButton:hover {
    background: #2d2b26;
    border-color: #6f6a5f;
}

QPushButton:pressed {
    background: #314844;
    border-color: #5aa195;
}

QMenu {
    background: #201f1c;
    border: 1px solid #38362f;
    border-radius: 6px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 18px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #314844;
    color: #f7f2e8;
}

QMenu::separator {
    height: 1px;
    background: #34322d;
    margin: 5px 2px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #151514;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 10px;
}

QScrollBar:horizontal {
    height: 10px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #3a3731;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #5a554c;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QWidget#CreateDockRoot {
    background: #181817;
}

QLabel#PanelTitle {
    background: transparent;
    color: #f7f2e8;
    font-size: 15px;
    font-weight: 800;
}

QLabel#PanelHint {
    background: #151514;
    border: 1px solid #292824;
    border-radius: 6px;
    color: #aaa397;
    padding: 8px;
}

QLabel#SectionLabel {
    background: transparent;
    color: #5aa195;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    padding-top: 4px;
    text-transform: uppercase;
}

QFrame#PanelSeparator {
    background: #292824;
    border: none;
    max-height: 1px;
    margin-top: 3px;
    margin-bottom: 3px;
}

QPushButton#CreatePresetButton,
QPushButton#CreateTemplateButton {
    background: #22211e;
    border: 1px solid #38362f;
    border-radius: 7px;
    color: #ded8cc;
    min-height: 34px;
    padding: 7px 8px;
    text-align: left;
}

QPushButton#CreatePresetButton:hover,
QPushButton#CreateTemplateButton:hover {
    background: #2d2b26;
    border-color: #5aa195;
    color: #f7f2e8;
}

QPushButton#CreateTemplateButton {
    background: #263631;
    border-color: #3d5f56;
}
