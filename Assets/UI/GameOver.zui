{
  "format": "zennity.ui",
  "version": 1,
  "canvas": {
    "name": "GameOverCanvas",
    "type": "canvas",
    "x": 0.0,
    "y": 0.0,
    "width": 1280.0,
    "height": 720.0,
    "visible": true,
    "children": [
      {
        "name": "GameOverLabel",
        "type": "UILabel",
        "x": 440.0,
        "y": 200.0,
        "width": 400.0,
        "height": 100.0,
        "visible": true,
        "children": [],
        "text": "GAME OVER",
        "font_size": 72,
        "text_color": "#FF3333"
      },
      {
        "name": "RetryButton",
        "type": "UIButton",
        "x": 390.0,
        "y": 350.0,
        "width": 200.0,
        "height": 60.0,
        "visible": true,
        "children": [],
        "text": "RETRY",
        "font_size": 32,
        "color": "#0066FF",
        "interactable": true,
        "event": "load_scene",
        "scene_path": "Assets/Scenes/Level1.zscene"
      },
      {
        "name": "MainMenuButton",
        "type": "UIButton",
        "x": 690.0,
        "y": 350.0,
        "width": 200.0,
        "height": 60.0,
        "visible": true,
        "children": [],
        "text": "MAIN MENU",
        "font_size": 32,
        "color": "#CC8800",
        "interactable": true,
        "event": "load_scene",
        "scene_path": "Assets/Scenes/MainMenu.zscene"
      }
    ]
  }
}
