        "z_order": 0,
        "children": []
      },
      {
        "type": "UIButton",
        "name": "TestButton",
        "x": 100,
        "y": 200,
        "width": 150,
        "height": 50,
        "text": "CLICK ME",
        "font_size": 16,
        "color": [255, 255, 255],
        "visible": true,
        "interactable": true,
        "z_order": 1,
        "children": []
      }
    ]
  }
}
