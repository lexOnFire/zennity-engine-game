{
  "format": "zennity.generic_graph",
  "category": "Logic",
  "name": "BossHealthLogic",
  "nodes": [
    {"id": "frame_loop", "type": "event.every_frame", "position": [50, 50]},
    {"id": "get_boss_health", "type": "variable.get", "position": [200, 50], "config": {"variable_name": "health"}},
    {"id": "get_max_health", "type": "variable.get", "position": [200, 120], "config": {"variable_name": "max_health"}},
    {"id": "calc_health_percent", "type": "math.divide", "position": [350, 85]},
    {"id": "update_boss_hud", "type": "ui.set_progress_bar", "position": [500, 85], "config": {"element_name": "BossHealthBar", "min": 0, "max": 100}},
    {"id": "check_dead", "type": "logic.branch", "position": [350, 180], "config": {"condition": "less_equal", "compare_value": 0}},
    {"id": "set_dead_trigger", "type": "animator.set_trigger", "position": [500, 180], "config": {"trigger_name": "dead"}},
    {"id": "wait_death_animation", "type": "logic.noop", "position": [650, 180]},
    {"id": "set_boss_defeated", "type": "variable.set", "position": [800, 180], "config": {"variable_name": "boss_defeated", "value": true, "scope": "project"}},
    {"id": "disable_collider", "type": "component.set_property", "position": [800, 240], "config": {"component_type": "BoxCollider2D", "property": "enabled", "value": false}},
    {"id": "stop_velocity", "type": "physics.set_velocity", "position": [800, 300], "config": {"velocity": [0, 0]}},
    {"id": "load_victory", "type": "scene.load", "position": [950, 240], "config": {"scene_path": "Assets/Scenes/Victory.zscene"}}
  ],
  "edges": [
    {"from": "frame_loop", "to": "get_boss_health", "from_pin": "frame", "to_pin": "execute"},
    {"from": "frame_loop", "to": "get_max_health", "from_pin": "frame", "to_pin": "execute"},
    {"from": "get_boss_health", "to": "calc_health_percent", "from_pin": "value", "to_pin": "a"},
    {"from": "get_max_health", "to": "calc_health_percent", "from_pin": "value", "to_pin": "b"},
    {"from": "calc_health_percent", "to": "update_boss_hud", "from_pin": "result", "to_pin": "value"},
    {"from": "get_boss_health", "to": "check_dead", "from_pin": "value", "to_pin": "value"},
    {"from": "check_dead", "to": "set_dead_trigger", "from_pin": "true", "to_pin": "execute"},
    {"from": "set_dead_trigger", "to": "wait_death_animation", "from_pin": "done", "to_pin": "execute"},
    {"from": "wait_death_animation", "to": "set_boss_defeated", "from_pin": "done", "to_pin": "execute"},
    {"from": "set_boss_defeated", "to": "disable_collider", "from_pin": "success", "to_pin": "execute"},
    {"from": "disable_collider", "to": "stop_velocity", "from_pin": "done", "to_pin": "execute"},
    {"from": "stop_velocity", "to": "load_victory", "from_pin": "done", "to_pin": "execute"}
  ]
}
