{
  "format": "zennity.generic_graph",
  "name": "VictoryLogic",
  "nodes": [
    {
      "id": "frame_loop",
      "type": "every_frame",
      "label": "Every Frame"
    },
    {
      "id": "get_score",
      "type": "project_get",
      "label": "Get Score",
      "project_variable": "score"
    },
    {
      "id": "get_coins",
      "type": "project_get",
      "label": "Get Coins",
      "project_variable": "coins"
    },
    {
      "id": "format_score",
      "type": "string_format",
      "label": "Format Score",
      "template": "Score: {0}"
    },
    {
