{
  "format": "zennity.generic_graph",
  "category": "Logic",
  "name": "PlayerHealthLogic",
  "nodes": [
    {
      "id": "frame_loop",
      "type": "event.every_frame",
      "position": [50, 50],
      "config": {}
    },
    {
      "id": "get_player_health",
      "type": "variable.get",
      "position": [200, 50],
      "config": {
        "variable_name": "health"
      }
    },
    {
      "id": "get_max_health",
      "type": "variable.get",
      "position": [200, 100],
      "config": {
        "variable_name": "max_health"
      }
    },
    {
      "id": "calculate_health_percent",
      "type": "math.divide",
      "position": [350, 75],
      "config": {}
    },
    {
      "id": "update_ui_health_bar",
      "type": "ui.set_progress_bar",
      "position": [500, 75],
      "config": {
        "element_name": "HealthBar",
        "min": 0,
        "max": 100
      }
    },
    {
      "id": "check_dead",
      "type": "logic.branch",
      "position": [350, 150],
      "config": {
        "condition": "less_equal",
        "compare_value": 0
      }
    },
    {
      "id": "trigger_death",
      "type": "event.custom",
      "position": [500, 150],
      "config": {
        "event_name": "player_death"
      }
    },
    {
      "id": "load_gameover_scene",
      "type": "scene.load_scene",
      "position": [650, 150],
      "config": {
        "scene_path": "Assets/Scenes/GameOver.zscene"
      }
    }
  ],
  "edges": [
    {
      "from": "frame_loop",
      "to": "get_player_health",
      "from_pin": "frame",
      "to_pin": "execute"
    },
    {
      "from": "frame_loop",
      "to": "get_max_health",
      "from_pin": "frame",
      "to_pin": "execute"
    },
    {
      "from": "get_player_health",
      "to": "calculate_health_percent",
      "from_pin": "value",
      "to_pin": "a"
    },
    {
      "from": "get_max_health",
      "to": "calculate_health_percent",
      "from_pin": "value",
      "to_pin": "b"
    },
    {
      "from": "calculate_health_percent",
      "to": "update_ui_health_bar",
      "from_pin": "result",
      "to_pin": "value"
    },
    {
      "from": "get_player_health",
      "to": "check_dead",
      "from_pin": "value",
      "to_pin": "value"
    },
    {
      "from": "check_dead",
      "to": "trigger_death",
      "from_pin": "true",
      "to_pin": "execute"
    },
    {
      "from": "trigger_death",
      "to": "load_gameover_scene",
      "from_pin": "event",
      "to_pin": "execute"
    }
  ]
}
