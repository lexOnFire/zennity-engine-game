{
  "format": "zennity.logic_graph",
  "version": 1,
  "enabled": true,
  "name": "PlayerMovement",
  "target": {
    "type": "name",
    "value": "Player"
  },
  "debug": {},
  "variables": {
    "speed": {
      "type": "number",
      "scope": "object",
      "default": 300.0
    }
  },
  "editor": {},
  "nodes": [
    {
      "id": "update",
      "type": "event_update",
      "position": [ 0, 0 ],
      "properties": {}
    },
    {
      "id": "axis",
      "type": "input_axis",
      "position": [ 250, 0 ],
      "properties": { "negative": "A", "positive": "D" }
    },
    {
      "id": "mult_speed",
      "type": "multiply",
      "position": [ 500, 0 ],
      "properties": {}
    },
    {
      "id": "get_speed",
      "type": "get_variable",
      "position": [ 250, -150 ],
      "properties": { "name": "speed" }
    },
    {
      "id": "move_horiz",
      "type": "move_by",
      "position": [ 750, 0 ],
      "properties": { "y": 0 }
    },
    {
      "id": "space_pressed",
      "type": "key_pressed",
      "position": [ 250, 200 ],
      "properties": { "key": "SPACE" }
    },
    {
      "id": "if_jump",
      "type": "if_else",
      "position": [ 500, 200 ],
      "properties": {}
    },
    {
      "id": "do_jump",
      "type": "move_by",
      "position": [ 750, 200 ],
      "properties": { "x": 0, "y": -600 }
    }
  ],
  "edges": [
    {
      "id": "e_flow_1",
      "from_node": "update",
      "from_port": "next",
      "to_node": "axis",
      "to_port": "in",
      "kind": "flow",
      "order": 0
    },
    {
      "id": "e_flow_2",
      "from_node": "axis",
      "from_port": "next",
      "to_node": "move_horiz",
      "to_port": "in",
      "kind": "flow",
      "order": 0
    },
    {
      "id": "e_flow_3",
      "from_node": "move_horiz",
      "from_port": "next",
      "to_node": "if_jump",
      "to_port": "in",
      "kind": "flow",
      "order": 0
    },
    {
      "id": "e_flow_4",
      "from_node": "if_jump",
      "from_port": "true",
      "to_node": "do_jump",
      "to_port": "in",
      "kind": "flow",
      "order": 0
    },
    {
      "id": "e_data_1",
      "from_node": "axis",
      "from_port": "value",
      "to_node": "mult_speed",
      "to_port": "a",
      "kind": "data",
      "order": 0
    },
    {
      "id": "e_data_2",
      "from_node": "get_speed",
      "from_port": "value",
      "to_node": "mult_speed",
      "to_port": "b",
      "kind": "data",
      "order": 0
    },
    {
      "id": "e_data_3",
      "from_node": "mult_speed",
      "from_port": "value",
      "to_node": "move_horiz",
      "to_port": "x",
      "kind": "data",
      "order": 0
    },
    {
      "id": "e_data_4",
      "from_node": "space_pressed",
      "from_port": "value",
      "to_node": "if_jump",
      "to_port": "condition",
      "kind": "data",
      "order": 0
    }
  ]
}
