{
  "format": "zennity.logic_graph",
  "version": 1,
  "name": "PlayerMovement",
  "variables": {"speed": {"type": "float", "default": 220.0}},
  "nodes": [
    {"id": "update", "type": "event_update", "title": "A cada frame", "category": "Eventos", "position": [40, 180], "properties": {}},
    {"id": "axis", "type": "input_axis", "title": "Teclas A / D", "category": "Movimento", "position": [280, 100], "properties": {"negative": "A", "positive": "D"}},
    {"id": "moving", "type": "if_else", "title": "Existe movimento?", "category": "Lógica", "position": [520, 100], "properties": {"condition": "axis != 0"}},
    {"id": "move", "type": "move", "title": "Ação: Andar", "category": "Movimento", "position": [780, 40], "properties": {"speed": 220.0}},
    {"id": "idle", "type": "play_animation", "title": "Ação: Parado", "category": "Ação", "position": [780, 180], "properties": {"state": "Idle"}},
    {"id": "space", "type": "key_pressed", "title": "Tecla Espaço", "category": "Condição", "position": [280, 330], "properties": {"key": "SPACE"}},
    {"id": "grounded", "type": "is_grounded", "title": "Está no chão?", "category": "Condição", "position": [520, 330], "properties": {}},
    {"id": "jump", "type": "jump", "title": "Ação: Pular", "category": "Movimento", "position": [780, 330], "properties": {"force": 440.0}}
  ],
  "edges": [
    {"id": "e1", "from_node": "update", "from_port": "next", "to_node": "axis", "to_port": "in", "kind": "flow"},
    {"id": "e2", "from_node": "axis", "from_port": "next", "to_node": "moving", "to_port": "in", "kind": "flow"},
    {"id": "e3", "from_node": "moving", "from_port": "true", "to_node": "move", "to_port": "in", "kind": "flow"},
    {"id": "e4", "from_node": "moving", "from_port": "false", "to_node": "idle", "to_port": "in", "kind": "flow"},
    {"id": "e5", "from_node": "update", "from_port": "next", "to_node": "space", "to_port": "in", "kind": "flow"},
    {"id": "e6", "from_node": "space", "from_port": "true", "to_node": "grounded", "to_port": "in", "kind": "flow"},
    {"id": "e7", "from_node": "grounded", "from_port": "true", "to_node": "jump", "to_port": "in", "kind": "flow"}
  ]
}
