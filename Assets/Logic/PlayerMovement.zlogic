{
  "format": "zennity.logic_graph",
  "version": 1,
  "enabled": false,
  "name": "PlayerMovement",
  "target": {
    "type": "name",
    "value": "Player"
  },
  "debug": {
    "breakpoints": [],
    "breakpoint_conditions": {},
    "watches": []
  },
  "variables": {
    "speed": {
      "type": "number",
      "scope": "object",
      "default": 220.0
    }
  },
  "editor": {
    "groups": [],
    "comments": []
  },
  "nodes": [
    {
      "id": "update",
      "type": "event_update",
      "title": "On Update",
      "category": "Events",
      "position": [
        80.0,
        80.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 134.0
      },
      "properties": {}
    },
    {
      "id": "axis",
      "type": "input_axis",
      "title": "Read Input Axis",
      "category": "Movement",
      "position": [
        370.0,
        80.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 134.0
      },
      "properties": {
        "negative": "A",
        "positive": "D"
      }
    },
    {
      "id": "moving",
      "type": "if_else",
      "title": "If / Else",
      "category": "Logic",
      "position": [
        660.0,
        80.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 134.0
      },
      "properties": {
        "condition": "axis != 0"
      }
    },
    {
      "id": "move",
      "type": "move",
      "title": "Move",
      "category": "Movement",
      "position": [
        950.0,
        80.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 134.0
      },
      "properties": {
        "speed": 220.0
      }
    },
    {
      "id": "idle",
      "type": "play_animation",
      "title": "Play Animation",
      "category": "Action",
      "position": [
        950.0,
        250.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 134.0
      },
      "properties": {
        "state": "Idle"
      }
    },
    {
      "id": "space",
      "type": "key_pressed",
      "title": "Key Pressed Now?",
      "category": "Condition",
      "position": [
        370.0,
        250.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 146.0
      },
      "properties": {
        "key": "SPACE"
      }
    },
    {
      "id": "grounded",
      "type": "is_grounded",
      "title": "Is Grounded?",
      "category": "Condition",
      "position": [
        660.0,
        250.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 146.0
      },
      "properties": {}
    },
    {
      "id": "jump",
      "type": "jump",
      "title": "Jump",
      "category": "Movement",
      "position": [
        950.0,
        420.0
      ],
      "editor": {
        "collapsed": false,
        "width": 210.0,
        "height": 134.0
      },
      "properties": {
        "force": 440.0
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from_node": "update",
      "from_port": "next",
      "to_node": "axis",
      "to_port": "in",
      "kind": "flow",
      "order": 0
    },
    {
      "id": "e2",
      "from_node": "axis",
      "from_port": "next",
      "to_node": "moving",
      "to_port": "in",
      "kind": "flow",
      "order": 1
    },
    {
      "id": "e3",
      "from_node": "moving",
      "from_port": "true",
      "to_node": "move",
      "to_port": "in",
      "kind": "flow",
      "order": 2
    },
    {
      "id": "e4",
      "from_node": "moving",
      "from_port": "false",
      "to_node": "idle",
      "to_port": "in",
      "kind": "flow",
      "order": 3
    },
    {
      "id": "e5",
      "from_node": "update",
      "from_port": "next",
      "to_node": "space",
      "to_port": "in",
      "kind": "flow",
      "order": 4
    },
    {
      "id": "e6",
      "from_node": "space",
      "from_port": "true",
      "to_node": "grounded",
      "to_port": "in",
      "kind": "flow",
      "order": 5
    },
    {
      "id": "e7",
      "from_node": "grounded",
      "from_port": "true",
      "to_node": "jump",
      "to_port": "in",
      "kind": "flow",
      "order": 6
    }
  ]
}
