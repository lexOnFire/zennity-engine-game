{
  "format": "zennity.logic_graph",
  "version": 1,
  "enabled": true,
  "name": "PlayerMovementLogic",
  "target": {
    "type": "name",
    "value": "Player"
  },
  "variables": {
    "speed": 200.0
  },
  "nodes": [
    {
      "id": "node_update",
      "type": "event_update",
      "name": "On Update",
      "position": [
        100,
        100
      ],
      "properties": {}
    },
    {
      "id": "node_input_h",
      "type": "input_axis",
      "name": "Input Horizontal",
      "position": [
        300,
        100
      ],
      "properties": {
        "axis_name": "horizontal"
      }
    },
    {
      "id": "node_input_v",
      "type": "input_axis",
      "name": "Input Vertical",
      "position": [
        300,
        250
      ],
      "properties": {
        "axis_name": "vertical"
      }
    },
    {
      "id": "node_move_by",
      "type": "move_by",
      "name": "Move By",
      "position": [
        600,
        150
      ],
      "properties": {
        "x": 0.0,
        "y": 0.0
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from_node": "node_update",
      "from_port": "next",
      "to_node": "node_input_h",
      "to_port": "in"
    },
    {
      "id": "e2",
      "from_node": "node_input_h",
      "from_port": "next",
      "to_node": "node_input_v",
      "to_port": "in"
    },
    {
      "id": "e3",
      "from_node": "node_input_v",
      "from_port": "next",
      "to_node": "node_move_by",
      "to_port": "in"
    },
    {
      "id": "e4",
      "from_node": "node_input_h",
      "from_port": "value",
      "to_node": "node_move_by",
      "to_port": "x"
    },
    {
      "id": "e5",
      "from_node": "node_input_v",
      "from_port": "value",
      "to_node": "node_move_by",
      "to_port": "y"
    }
  ]
}