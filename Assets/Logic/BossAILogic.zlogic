{
  "format": "zennity.generic_graph",
  "category": "Logic",
  "name": "BossAILogic",
  "nodes": [
    {"id": "frame_loop", "type": "event.every_frame", "position": [50, 50]},
    {"id": "find_player", "type": "object.find_by_name", "position": [200, 50], "config": {"object_name": "Player"}},
    {"id": "get_player_pos", "type": "object.get_position", "position": [350, 50]},
    {"id": "get_boss_pos", "type": "transform.get_position", "position": [350, 120]},
    {"id": "calc_distance", "type": "math.distance", "position": [500, 85]},
    {"id": "get_detection", "type": "variable.get", "position": [200, 200], "config": {"variable_name": "detection_range"}},
    {"id": "check_detected", "type": "logic.branch", "position": [650, 85], "config": {"condition": "less_equal"}},
    {"id": "get_phase", "type": "variable.get", "position": [200, 270], "config": {"variable_name": "phase"}},
    {"id": "get_health", "type": "variable.get", "position": [200, 330], "config": {"variable_name": "health"}},
    {"id": "get_max_health", "type": "variable.get", "position": [200, 390], "config": {"variable_name": "max_health"}},
    {"id": "check_phase2", "type": "logic.branch", "position": [350, 350], "config": {"condition": "less_equal", "compare_value": 250}},
    {"id": "set_phase2", "type": "variable.set", "position": [500, 350], "config": {"variable_name": "phase", "value": 2}},
    {"id": "get_attack_range", "type": "variable.get", "position": [200, 450], "config": {"variable_name": "attack_range"}},
    {"id": "check_attack_range", "type": "logic.branch", "position": [650, 280], "config": {"condition": "less_equal"}},
    {"id": "stop_boss", "type": "physics.set_velocity", "position": [800, 280], "config": {"velocity": [0, 0]}},
    {"id": "calc_direction", "type": "math.vector2_create", "position": [800, 85]},
    {"id": "normalize_dir", "type": "math.vector2_normalize", "position": [800, 140]},
    {"id": "get_move_speed", "type": "variable.get", "position": [200, 520], "config": {"variable_name": "move_speed"}},
    {"id": "apply_speed", "type": "math.multiply", "position": [950, 140]},
    {"id": "set_velocity", "type": "physics.set_velocity", "position": [1100, 140]},
    {"id": "set_speed_param", "type": "animator.set_parameter", "position": [1100, 200], "config": {"parameter": "speed"}}
  ],
  "edges": [
    {"from": "frame_loop", "to": "find_player", "from_pin": "frame", "to_pin": "execute"},
    {"from": "find_player", "to": "get_player_pos", "from_pin": "object", "to_pin": "object"},
    {"from": "frame_loop", "to": "get_boss_pos", "from_pin": "frame", "to_pin": "execute"},
    {"from": "get_player_pos", "to": "calc_distance", "from_pin": "position", "to_pin": "point_b"},
    {"from": "get_boss_pos", "to": "calc_distance", "from_pin": "position", "to_pin": "point_a"},
    {"from": "calc_distance", "to": "check_detected", "from_pin": "distance", "to_pin": "value"},
    {"from": "get_detection", "to": "check_detected", "from_pin": "value", "to_pin": "compare_value"},
    {"from": "check_detected", "to": "get_health", "from_pin": "true", "to_pin": "execute"},
    {"from": "get_health", "to": "get_max_health", "from_pin": "value", "to_pin": "execute"},
    {"from": "get_max_health", "to": "check_phase2", "from_pin": "value", "to_pin": "compare_value"},
    {"from": "get_health", "to": "check_phase2", "from_pin": "value", "to_pin": "value"},
    {"from": "check_phase2", "to": "set_phase2", "from_pin": "true", "to_pin": "execute"},
    {"from": "calc_distance", "to": "check_attack_range", "from_pin": "distance", "to_pin": "value"},
    {"from": "get_attack_range", "to": "check_attack_range", "from_pin": "value", "to_pin": "compare_value"},
    {"from": "check_attack_range", "to": "stop_boss", "from_pin": "true", "to_pin": "execute"},
    {"from": "check_detected", "to": "calc_direction", "from_pin": "true", "to_pin": "execute"},
    {"from": "get_player_pos", "to": "calc_direction", "from_pin": "position", "to_pin": "x"},
    {"from": "get_boss_pos", "to": "calc_direction", "from_pin": "position", "to_pin": "y"},
    {"from": "calc_direction", "to": "normalize_dir", "from_pin": "vector", "to_pin": "vector"},
    {"from": "normalize_dir", "to": "apply_speed", "from_pin": "normalized", "to_pin": "a"},
    {"from": "get_move_speed", "to": "apply_speed", "from_pin": "value", "to_pin": "b"},
    {"from": "apply_speed", "to": "set_velocity", "from_pin": "result", "to_pin": "velocity"},
    {"from": "set_velocity", "to": "set_speed_param", "from_pin": "done", "to_pin": "execute"}
  ]
}
