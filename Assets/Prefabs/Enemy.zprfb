{
  "format": "zennity.prefab",
  "name": "Enemy",
  "root": {
    "id": "enemy_root",
    "name": "Enemy",
    "type": "GameObject",
    "enabled": true,
    "components": [
      {
        "type": "Transform",
        "position": [0, 0],
        "rotation": 0,
        "scale": [1, 1]
      },
      {
        "type": "SpriteRenderer",
        "sprite": "Assets/Sprites/MyPlatformer/enemy.png",
        "color": [1, 1, 1, 1],
        "layer": 0
      },
      {
        "type": "BoxCollider2D",
        "size": [0.8, 1.0],
        "offset": [0, 0],
        "is_trigger": false,
        "layer": "ENEMY"
      },
      {
        "type": "RigidBody2D",
        "body_type": "dynamic",
        "gravity_scale": 0,
        "mass": 1,
        "drag": 0,
        "angular_drag": 0,
        "constraints": "freeze_rotation_z"
      },
      {
        "type": "Animator",
        "controller": "Assets/Animations/EnemyAnimationController.zcontroller",
        "speed": 1.0
      }
    ],
    "variables": {
      "health": 100,
      "max_health": 100,
      "move_speed": 100,
      "attack_damage": 10,
      "attack_range": 48,
      "detection_range": 300,
      "attack_cooldown": 1.0,
      "cooldown_timer": 1.0
    },
    "logic_graphs": [
      {
        "path": "Assets/Logic/EnemyAILogic.zlogic",
        "name": "EnemyAI"
      },
      {
        "path": "Assets/Logic/EnemyAttackLogic.zlogic",
        "name": "EnemyAttack"
      }
    ]
  }
}
