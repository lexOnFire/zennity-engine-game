  "notes": {
    "description": "Exemplo de Counter usando nós de UI novos",
    "usage": [
      "1. Selecione IncrementButton na Hierarchy",
      "2. Na Inspector, add component: LogicGraph",
      "3. Clique 'Open in Editor'",
      "4. Arraste 'Increment UI Value' para o grafo",
      "5. Configure: element='CounterLabel', amount=1, max_value=999",
      "6. Conecte: button.on_click → Increment UI Value.in",
      "7. Repita para DecrementButton (use 'Decrement UI Value')",
      "8. Para Reset: use 'Set UI Value' com value=0",
      "9. Play (F5) e teste!"
    ],
    "learning_goals": [
      "✓ Usar Increment UI Value para mudar valores",
      "✓ Usar Decrement UI Value com limite mínimo",
      "✓ Usar Set UI Value para reset",
      "✓ Integrar buttons com Logic Graph",
      "✓ Testar em Play Mode"
    ],
    "variations": [
      "- Adicionar Animate Material para feedback visual",
      "- Adicionar límites (max_value/min_value)",
      "- Adicionar Format UI Text para 'Pontos: X'",
      "- Combinar com UIBinder para auto-sync"
    ]
  }
}
