  "nodes": [
    {
      "id": "greeting",
      "type": "dialogue.speech",
      "inputs": {
        "speaker": "Merchant",
        "text": "Olá, bem-vindo à minha loja! O que posso fazer por você?"
      }
    },
    {
      "id": "choices_node",
      "type": "dialogue.choice",
      "inputs": {
        "prompt": "O que você gostaria de fazer?"
      }
    },
    {
      "id": "option_buy",
      "type": "dialogue.speech",
      "inputs": {
        "speaker": "Merchant",
        "text": "Excelente! Temos várias poções e itens disponíveis."
      }
    },
    {
      "id": "option_sell",
      "type": "dialogue.speech",
      "inputs": {
        "speaker": "Merchant",
        "text": "Ah, você tem algo para vender? Mostre-me!"
      }
    },
    {
      "id": "option_leave",
      "type": "dialogue.speech",
      "inputs": {
        "speaker": "Merchant",
        "text": "Tudo bem, volte sempre que precisar!"
      }
    },
    {
      "id": "end_node",
      "type": "dialogue.end",
      "inputs": {}
    }
  ],
